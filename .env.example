# Use live Edamam when credentials are present; keep the transparent synthetic fallback.
SMART_BASKET_MODE=demo
# Comma-separated browser origins; use localhost consistently for cookies.
SMART_BASKET_CORS_ORIGINS=http://localhost:3000
SILPO_MCP_URL=https://mcp.silpo.ua/mcp
# Must exactly match the callback registered dynamically with Silpo.
SILPO_OAUTH_CALLBACK_URL=http://localhost:8000/api/auth/silpo/callback
SMART_BASKET_FRONTEND_URL=http://localhost:3000
FATSECRET_CONSUMER_KEY=your_key
FATSECRET_CONSUMER_SECRET=your_secret
FATSECRET_OAUTH_CALLBACK_URL=http://localhost:8000/api/auth/fatsecret/callback
FATSECRET_TIMEOUT_SECONDS=10
FATSECRET_ALLOW_EDAMAM_EXPORT=false
SMART_BASKET_MEALS_SOURCE=edamam
EDAMAM_SYNTHETIC_FALLBACK=true
EDAMAM_MEAL_PLANNER_APP_ID=your_app_id
EDAMAM_MEAL_PLANNER_APP_KEY=your_app_key
EDAMAM_ACCOUNT_USER=demo_user_id
# Optional deployment override when a directly configured user ID cannot be edited atomically.
EDAMAM_ACCOUNT_USER_OVERRIDE=
EDAMAM_MEAL_PLANNER_BASE_URL=https://api.edamam.com
EDAMAM_TIMEOUT_SECONDS=8
GEMINI_API_KEY=your_key
GEMINI_MODEL=gemini-3.7-flash
